# Primary LLM Configuration (Groq - Free Credits)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Fallback LLM
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embeddings Model (all-minilm-l6-v2 runs locally 100% free; text-embedding-3-small requires OpenAI)
EMBEDDING_MODEL=all-minilm-l6-v2

# Tavily Web Search (for external IT knowledge search fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=fde-it-support-rag
PINECONE_NAMESPACE=company-it-kb

# Security & Admin Key
ADMIN_API_KEY=change-me-in-production

# Application Settings
APP_ENV=development
